# Copy to .env for Docker Compose, then supply only the credentials used by
# your chosen model provider and channels. Never commit the filled .env file.
# AgentX's dashboard wizard can also write the corresponding agentx.json.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional channel credentials; configure matching references in agentx.json.
TELEGRAM_BOT_TOKEN=
GITLAB_TOKEN=
GITHUB_TOKEN=
