<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the watch call spike (#1636, step 1). It never ships
     in a release build. See apps/android/README.md, "Watch call spike". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The call permissions come from the main manifest (Talk to AgentX). -->

    <application>
        <activity
            android:name=".watchspike.WatchSpikeActivity"
            android:exported="true"
            android:label="AgentX watch spike">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".watchspike.WatchSpikeConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
