<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AgentX" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
    </style>
    <!-- Shown for the moment it takes Chrome to open the phone app. -->
    <style name="Theme.AgentX.Launch" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
    </style>
</resources>
