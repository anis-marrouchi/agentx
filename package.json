{
  "name": "agentix-cli",
  "version": "0.290.0",
  "description": "Put the coding agent you already use on call: it answers in chat and on issues, runs on a schedule, and asks you before anything that matters, on a machine you own. Runs a team of AI agents across Telegram, WhatsApp, GitLab, GitHub, crons, webhooks and mesh tasks, on Claude Code, Codex, OpenCode or any LLM API. Web wizard for operators, CLI for engineers.",
  "license": "MIT",
  "author": {
    "name": "anis_marrouchi",
    "url": "https://twitter.com/anis_marrouchi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anis-marrouchi/agentx.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/daemon/ui/LICENSE.affectui",
    "scripts/postinstall.mjs",
    "agentx.example.json",
    "apps/mac-voice/Sources",
    "apps/mac-voice/Resources",
    "apps/mac-voice/build.sh",
    "apps/mac-helper/Sources",
    "apps/mac-helper/Resources",
    "apps/mac-helper/build.sh"
  ],
  "keywords": [
    "ai",
    "agent",
    "agent-harness",
    "multi-agent",
    "orchestrator",
    "claude-code",
    "opencode",
    "claude",
    "telegram",
    "whatsapp",
    "cron",
    "a2a",
    "mesh",
    "swarm",
    "mcp",
    "self-hosted",
    "bring-your-own-key"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.web.config.ts && vite build --config vite.hub.config.ts",
    "build:web": "tsup --config tsup.web.config.ts && vite build --config vite.hub.config.ts",
    "build:hub": "vite build --config vite.hub.config.ts",
    "hub:budget": "node scripts/hub-budget.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "bench:context": "tsx bench/context-size.ts",
    "bench:profiles": "tsx bench/context-profiles.ts",
    "bench:compare": "tsx bench/compare-claude-code.ts",
    "bench:required": "tsx bench/workflow-required.ts",
    "bench:catch": "tsx bench/catch-promise.ts",
    "bench:browser": "tsx bench/browser-drive.ts",
    "bench:leann": "tsx bench/leann-1390/cli.ts",
    "test": "vitest run",
    "clean": "rimraf dist",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mdx}\" --cache",
    "eval": "vitest run test/eval/",
    "eval:track": "TRACK_SCORES=1 vitest run test/eval/real-data-eval.test.ts",
    "usage:track": "tsx src/scripts/track-usage.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:check": "node docs/.scripts/check-sidebar.mjs && node docs/.scripts/diagrams.mjs --check && vitepress build docs",
    "docs:diagrams": "node docs/.scripts/diagrams.mjs",
    "docs:demo": "node dist/cli.js demo --no-open --keep --dashboard-token docs-demo-only-token",
    "docs:seed": "node docs/.scripts/seed-demo.mjs",
    "docs:shots": "node docs/.scripts/capture.mjs",
    "docs:shots:mobile": "node docs/.scripts/capture-mobile.mjs",
    "docs:social-preview": "node docs/.scripts/social-preview.mjs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@roamhq/wrtc": "^0.10.0",
    "@streamdown/code": "^2.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^12.9.0",
    "chalk": "5.2.0",
    "cli-highlight": "^2.1.11",
    "cmdk": "^1.1.1",
    "commander": "^10.0.0",
    "cosmiconfig": "^8.1.3",
    "cronstrue": "^3.14.0",
    "diff": "^9.0.0",
    "execa": "^7.0.0",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "imapflow": "^2.9.1",
    "ink": "^5.0.1",
    "js-yaml": "^4.1.1",
    "jsqr": "^1.4.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "minisearch": "^7.2.0",
    "node-fetch": "^3.3.0",
    "nodemailer": "^10.2.1",
    "ora": "^6.1.2",
    "postal-mime": "^4.1.4",
    "prompts": "^2.4.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.6.0",
    "streamdown": "^2.8.0",
    "undici": "^8.1.0",
    "web-push": "^3.6.7",
    "yaml": "^2.8.4",
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@types/fs-extra": "^11.0.1",
    "@types/nodemailer": "^8.0.2",
    "@types/prompts": "^2.4.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-static": "^1.8.0",
    "mermaid": "^11.14.0",
    "prettier": "^3.0.0",
    "rimraf": "^4.1.3",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^6.6.3",
    "tsx": "^4.23.15",
    "type-fest": "^3.8.0",
    "typescript": "^4.9.3",
    "vite": "~5.4.21",
    "vite-tsconfig-paths": "^4.3.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  }
}
