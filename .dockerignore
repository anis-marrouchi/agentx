# Only build inputs belong in the context. Keep runtime state, credentials,
# private notes and local screenshots out of the image.
**
!Dockerfile
!docker/
!docker/init.mjs
!docker/demo/
!docker/demo/start.sh
!docs/
!docs/.scripts/
!docs/.scripts/seed-demo.mjs
!docs/public/
!docs/public/examples/
!docs/public/examples/demo-report.json
!package.json
!pnpm-lock.yaml
!.npmrc
!tsconfig.json
!tsup.config.ts
!tsup.web.config.ts
!src/
!src/**
src/web/workflow-editor/HANDOFF.md
!scripts/
!scripts/postinstall.mjs
!agentx.example.json
!README.md
!LICENSE
